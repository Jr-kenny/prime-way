# Copy this file to `.env` and fill in the values. Never commit `.env`.
# No secret belongs in this repo. The Relay API key stays in the
# backend's environment, never here.

# Privy App ID (from the Privy dashboard, after creating an app).
# Without it, the Privy login screens explain what is missing and the
# import-wallet path still works.
EXPO_PUBLIC_PRIVY_APP_ID=

# Privy Client ID (optional, from the same dashboard).
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# The Prime Way backend. The default is the live Render service.
EXPO_PUBLIC_BACKEND_URL=https://prime-way-backend.onrender.com
